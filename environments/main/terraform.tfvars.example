# ============================================================================
# Environment Configuration Template
# ============================================================================
# Copy this file to terraform.tfvars and provide your environment-specific values
# Note: terraform.tfvars is gitignored and should never be committed
# ============================================================================

# AWS Configuration
aws_region = "us-east-1"  # AWS region for all resources
environment = "prod"      # Environment name (prod, staging, dev)
cluster_name = "blue"     # Cluster identifier (blue, green, etc.)

# ============================================================================
# Network Configuration
# ============================================================================
# Use existing VPC and subnets - these should already exist in your AWS account

vpc_id = "vpc-xxxxxxxxxxxxxxxxx"  # Existing VPC ID

# Public subnets for Application Load Balancer (minimum 2 for high availability)
public_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",  # Availability Zone 1
  "subnet-yyyyyyyyyyyyyyyyy",  # Availability Zone 2
]

# Private subnets for ECS tasks (minimum 2 for high availability)
private_subnet_ids = [
  "subnet-xxxxxxxxxxxxxxxxx",  # Availability Zone 1
  "subnet-yyyyyyyyyyyyyyyyy",  # Availability Zone 2
  "subnet-zzzzzzzzzzzzzzzzz",  # Availability Zone 3 (optional)
  "subnet-wwwwwwwwwwwwwwwwww", # Availability Zone 4 (optional)
]

# ============================================================================
# Domain Configuration
# ============================================================================
# Your application domains - configure DNS records to point to ALB

domain      = "app.example.com"      # Main application domain
api_domain   = "api.example.com"      # API endpoint domain
login_domain = "login.example.com"   # Authentication domain
base_domain  = "example.com"           # Base domain for SSL certificates

# ============================================================================
# Service Scaling Configuration
# ============================================================================
# Desired number of tasks for each service
# Auto-scaling will adjust based on load (if enabled)

app_scale      = 4   # Main application service
api2_scale     = 4   # API service
worker_scale   = 20  # Background job workers
urltopng_scale = 2   # URL to PNG conversion service

# ============================================================================
# Container Image Configuration
# ============================================================================
# Configure your Docker images - can use Docker Hub or AWS ECR

# Option 1: Use Docker Hub (set use_ecr = false)
app_image                = "your-org/app:latest"
api2_image               = "your-org/api2:latest"
canvas_image             = "your-org/canvas:latest"
process_job_worker_image = "your-org/worker:latest"
urltopng_image           = "your-org/urltopng:latest"
gearman_server_image     = "your-org/gearmand:latest"
scheduler_image          = "your-org/scheduler:latest"

# Option 2: Use AWS ECR (set use_ecr = true and provide image tags)
use_ecr = true

# ECR Image Tags (used when use_ecr = true)
app_image_tag                = "v1.0.0"
api2_image_tag               = "v1.0.0"
canvas_image_tag             = "latest"
process_job_worker_image_tag = "v1.0.0"
urltopng_image_tag           = "v1.0.0"
gearman_server_image_tag     = "latest"
scheduler_image_tag          = "v1.0.0"

# ============================================================================
# Docker Hub Credentials (for private container images)
# ============================================================================
# Required only if using private Docker Hub repositories
# Terraform will automatically create AWS Secrets Manager secret for ECS to use

# Option 1: Use existing secret ARN (recommended if secret already exists)
dockerhub_secret_arn = "arn:aws:secretsmanager:us-east-1:123456789012:secret:cluster-dockerhub-credentials-xxxxx"

# Option 2: Provide credentials - Terraform creates secret in Secrets Manager
dockerhub_username = "your-dockerhub-username"
dockerhub_password = "your-dockerhub-access-token"  # Use access token (not password) for better security

# ============================================================================
# Resource Sizing (CPU and Memory)
# ============================================================================
# CPU: 1024 = 1 vCPU, Memory: in MB
# Adjust based on your application requirements and load testing

app_cpu    = 2048  # 2 vCPU
app_memory = 4096  # 4 GB

api2_cpu    = 1024  # 1 vCPU
api2_memory = 2048  # 2 GB

worker_cpu    = 512   # 0.5 vCPU
worker_memory = 1024  # 1 GB

# ============================================================================
# Monitoring & Service Discovery
# ============================================================================

# CloudWatch Logs retention period (days)
log_retention_days = 30  # Adjust based on compliance/audit requirements

# AWS Service Discovery for internal service communication
enable_service_discovery    = true
service_discovery_namespace = "your-app.local"  # Internal DNS namespace

# ============================================================================
# Auto Scaling Configuration
# ============================================================================
# Configure automatic scaling based on CPU/memory utilization

enable_auto_scaling = true

# Minimum number of tasks (always running)
min_capacity = {
  app    = 2   # Minimum app instances
  api2   = 2   # Minimum API instances
  worker = 5   # Minimum worker instances
}

# Maximum number of tasks (scales up to this limit)
max_capacity = {
  app    = 10  # Maximum app instances
  api2   = 10  # Maximum API instances
  worker = 50  # Maximum worker instances
}

# ============================================================================
# Security Configuration
# ============================================================================
# CIDR blocks allowed to access the Application Load Balancer
# IMPORTANT: Restrict to specific IPs/ranges in production

allowed_cidr_blocks = ["0.0.0.0/0"]  # WARNING: Allows all IPs - restrict in production

# Security Groups (optional - if using existing security groups)
# database_security_group_id = "sg-xxxxxxxxxxxxxxxxx"  # RDS/MySQL security group
# mongodb_security_group_id  = "sg-xxxxxxxxxxxxxxxxx"   # MongoDB security group

# ============================================================================
# Database Configuration
# ============================================================================
# Database connection details for application services
# IMPORTANT: For production, use AWS Secrets Manager or SSM Parameter Store
# to store database_password instead of plain text

database_host     = "your-database-host.rds.amazonaws.com"  # RDS endpoint
database_name     = "your_database_name"                     # Database name
database_user     = "your_database_user"                     # Database username
database_password = "your-secure-password"                    # Database password (sensitive)

# ============================================================================
# MongoDB Configuration
# ============================================================================
# MongoDB connection details for application services
# IMPORTANT: For production, use AWS Secrets Manager or SSM Parameter Store
# to store mongodb_password instead of plain text

mongodb_host           = "your-mongodb-host"              # MongoDB hostname or IP
mongodb_user           = "your_mongodb_user"              # MongoDB username
mongodb_password       = "your-mongodb-password"          # MongoDB password (sensitive)
mongodb_database       = "your_mongodb_database"          # MongoDB database name
mongodb_email_database = "email"                          # MongoDB email database name

# Security Groups (optional - if database is in different VPC or requires specific access)
# database_security_group_id = "sg-xxxxxxxxxxxxxxxxx"
# mongodb_security_group_id  = "sg-xxxxxxxxxxxxxxxxx"

# ============================================================================
# SSL/TLS Configuration
# ============================================================================
# ACM Certificate ARN for HTTPS (optional - leave empty for HTTP only)
# Certificate must be in the same region as the ALB

acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ============================================================================
# Application Configuration
# ============================================================================
app_env = "production"  # Application environment (production, staging, development)

# ============================================================================
# Third-Party Service Configuration (Optional)
# ============================================================================
# Twilio SMS service configuration (leave empty if not using Twilio)
# IMPORTANT: For production, use AWS Secrets Manager or SSM Parameter Store
# to store twilio_token instead of plain text

twilio_sid                     = ""  # Twilio Account SID
twilio_token                   = ""  # Twilio Auth Token (sensitive)
twilio_msg_service_sid         = ""  # Twilio Messaging Service SID
twilio_msg_status_callback_url = ""  # Twilio message status callback URL

# ============================================================================
# Resource Tags
# ============================================================================
# Tags applied to all resources for organization and cost tracking

tags = {
  Project     = "YourProjectName"
  Environment = "production"
  Team        = "Platform"
  ManagedBy   = "Terraform"
}

