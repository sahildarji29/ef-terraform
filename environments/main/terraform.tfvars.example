# Main/Production Environment Configuration
# Copy this to terraform.tfvars and fill in your values

aws_region = "us-east-1"
environment = "prod"
cluster_name = "blue"

# VPC Configuration - Use existing VPC
vpc_id = "vpc-43a1cc24"  # Replace with your VPC ID

# Subnet IDs - Replace with your actual subnet IDs
public_subnet_ids = [
  "subnet-be932892",  # us-east-1b
  "subnet-ebcf39a2",  # us-east-1c
]

private_subnet_ids = [
  "subnet-be932892",  # us-east-1b
  "subnet-ebcf39a2",  # us-east-1c
  "subnet-eda71467",  # us-east-1d
  "subnet-cd3f2af0",  # us-east-1e
]

# Domain Configuration
domain = "app.eventfarm.com"
api_domain = "api.eventfarm.com"
login_domain = "login.eventfarm.com"
base_domain = "eventfarm.com"

# Service Scaling
app_scale = 4
api2_scale = 4
worker_scale = 20
urltopng_scale = 2

# Docker Images
app_image = "membersuite/app:auth0"
api2_image = "membersuite/api2:7.3.28"
canvas_image = "membersuite/canvas:latest"
process_job_worker_image = "membersuite/process-job-worker:8.4.5-dev"
urltopng_image = "jasonraimondi/url-to-png:0.11.0"
gearman_server_image = "artefactual/gearmand:1.1.19.1-alpine"
scheduler_image = "membersuite/scheduler:1.6.0"

# Resource Sizing
app_cpu = 2048
app_memory = 4096
api2_cpu = 1024
api2_memory = 2048
worker_cpu = 512
worker_memory = 1024

# CloudWatch Logs
log_retention_days = 30

# Service Discovery
enable_service_discovery = true
service_discovery_namespace = "eventfarm.local"

# Auto Scaling
enable_auto_scaling = true
min_capacity = {
  app    = 2
  api2   = 2
  worker = 5
}
max_capacity = {
  app    = 10
  api2   = 10
  worker = 50
}

# Security
allowed_cidr_blocks = ["0.0.0.0/0"]  # Restrict this in production

# Database Security Groups (optional)
# database_security_group_id = "sg-xxxxxxxxx"
# mongodb_security_group_id  = "sg-xxxxxxxxx"

# Database Configuration (for scheduler)
# Note: Use AWS Secrets Manager instead of plain text passwords
database_host = "184.72.251.118"
database_name = "eventfarm_db_03"
database_user = "eventfarm"
# database_password = ""  # Use Secrets Manager instead

# ACM Certificate (optional - use existing certificate ARN)
# acm_certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/xxxxx"

# Tags
tags = {
  Project     = "EventFarm"
  Environment = "production"
  Team        = "Platform"
}

